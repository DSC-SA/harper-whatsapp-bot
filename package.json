{
  "name": "harper-whatsapp-bot",
  "version": "1.0.0",
  "description": "Harper — a Baileys-based WhatsApp bot with watermarked stickers, auto-mute, anti-link and spam protection.",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-bot",
    "baileys",
    "wa-bot",
    "sticker",
    "automute",
    "antilink",
    "antispam"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.24",
    "axios": "^1.7.9",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "node-cron": "^3.0.3",
    "node-webpmux": "^3.2.0",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.32.6"
  },
  "overrides": {
    "libsignal": "https://codeload.github.com/whiskeysockets/libsignal-node/tar.gz/refs/heads/master"
  }
}
