# ── Bot identity ────────────────────────────────
PREFIX=/
BOT_NAME=Harper
# OWNER/SUDO accept numbers (whitelist). SUDO is also settable at runtime
# from WhatsApp by the owner: /setvar SUDO=123 → stored in data/vars.json
OWNER=<your-phone-number-with-country-code, e.g. 919876543210>

# ── Session (Koyeb: base64 SESSION_ID produced by /pair + /mysession) ──
SESSION_ID=

# ── Database (Koyeb managed Postgres) ────────────
# Connection string from your Koyeb database service.
# On local runs this can stay blank (bot works file-only).
DATABASE_URL=postgres://user:pass@host:port/dbname?sslmode=require

# ── Koyeb API token (optional) ────────────────────
# Only needed if you redeploy/hit the Koyeb API from scripts; not used at runtime.
KOYEB_API_TOKEN=

# ── MLBB registration trigger group(s) ────────────
MLBB_REG_GROUP=120363404307438604@g.us,120363423706976066@g.us

# ── Stickers ────────────────────────────────────
STICKER_PACK=DawnSphereCommunity
STICKER_AUTHOR=Harper
WATERMARK=DawnSphereCommunity - DSC

# ── Keep-alive (free Koyeb instances scale to zero after 1h idle) ──
PORT=3000
HARPER_APP_URL=https://<your-app>.koyeb.app
KEEP_ALIVE_MIN=40

# ── Protection defaults ─────────────────────────
DEFAULT_ANTILINK=off
ANTILINK_ACTION=warn        # warn | kick | mute
FLOOD_LIMIT=6
FLOOD_WINDOW=15             # seconds
SPAM_ACTION=mute            # warn | mute | kick
SPAM_MUTE_MIN=30
MAX_WARNS=3
WARN_MUTE_MIN=30