# ── Bot identity ────────────────────────────────
PREFIX=!
BOT_NAME=Harper
OWNER=<your-phone-number-with-country-code, e.g. 919876543210>

# ── Session (Koyeb: base64 SESSION_ID produced by !pair / !mysession) ──
SESSION_ID=

# ── Stickers ────────────────────────────────────
STICKER_PACK=DawnSphereCommunity
STICKER_AUTHOR=Harper
WATERMARK=DawnSphereCommunity

# ── Keep-alive (free Koyeb instances scale to zero after 1h idle) ──
PORT=3000
HARPER_APP_URL=https://<your-app>.koyeb.app
KEEP_ALIVE_MIN=40

# ── Protection defaults ─────────────────────────
DEFAULT_ANTILINK=off
ANTILINK_ACTION=warn        # warn | kick | mute
FLOOD_LIMIT=6
FLOOD_WINDOW=15             # seconds
SPAM_ACTION=mute            # warn | mute | kick
SPAM_MUTE_MIN=30
MAX_WARNS=3
WARN_MUTE_MIN=30